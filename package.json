{
  "name": "@dsh-external/dsh-peak-status",
  "version": "0.1.0",
  "description": "DeepSeek API peak/off-peak status for the DSH composer: Beijing wall clock, the current peak or idle window, and a live countdown to the next switch.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "author": "WONGIII",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WONGIII/dsh-peak-status.git"
  },
  "homepage": "https://github.com/WONGIII/dsh-peak-status#readme",
  "bugs": {
    "url": "https://github.com/WONGIII/dsh-peak-status/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client-plugin",
    "peak-hours",
    "off-peak",
    "beijing-time",
    "composer"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@types/react": "~18.3.31",
    "typescript": "^5.9.3"
  }
}
